#!/usr/bin/env bash

if [[ $* == "-Qq" ]]; then
  printf 'bash\ngit\npacman\n'
  exit
fi

if [[ $* == "-S -l -q" ]]; then
  printf 'bash\ngit\npacman\nremotepkg\nripgrep\n'
  exit
fi

if [[ $* == "-Q -q -e" ]]; then
  printf 'bash\ngit\nlocalpkg\npacman\n'
  exit
fi

printf 'pacman'
printf ' %s' "$@"
printf '\n'
