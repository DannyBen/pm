# :command.parse_requirements
parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        pm_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.dependencies_filter
  missing_deps=
  # :dependency.filter
  if ! command -v pacman >/dev/null 2>&1; then
    printf "missing dependency: pacman\n" >&2
    printf "%s\n\n" "pm requires pacman and is intended for Arch Linux" >&2
    missing_deps=1
  fi

  if [[ -n $missing_deps ]]; then
    exit 1
  fi

  # :command.command_filter
  action=${1:-}

  case $action in
    -*) ;;

    update | u)
      action="update"
      shift
      pm_update_parse_requirements "$@"
      shift $#
      ;;

    install | add)
      action="install"
      shift
      pm_install_parse_requirements "$@"
      shift $#
      ;;

    remove | rm)
      action="remove"
      shift
      pm_remove_parse_requirements "$@"
      shift $#
      ;;

    update-keys | keys)
      action="update-keys"
      shift
      pm_update_keys_parse_requirements "$@"
      shift $#
      ;;

    list | ls)
      action="list"
      shift
      pm_list_parse_requirements "$@"
      shift $#
      ;;

    info)
      action="info"
      shift
      pm_info_parse_requirements "$@"
      shift $#
      ;;

    search)
      action="search"
      shift
      pm_search_parse_requirements "$@"
      shift $#
      ;;

    provides)
      action="provides"
      shift
      pm_provides_parse_requirements "$@"
      shift $#
      ;;

    index)
      action="index"
      shift
      pm_index_parse_requirements "$@"
      shift $#
      ;;

    catalog)
      action="catalog"
      shift
      pm_catalog_parse_requirements "$@"
      shift $#
      ;;

    origin)
      action="origin"
      shift
      pm_origin_parse_requirements "$@"
      shift $#
      ;;

    # :command.command_fallback
    "")
      pm_usage >&2
      exit 1
      ;;

    *)
      printf "invalid command: %s\n" "$action" >&2
      exit 1
      ;;

  esac

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

